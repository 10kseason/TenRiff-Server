{$TENRIFF_DOMAIN:localhost} {
    encode zstd gzip

    request_body {
        max_size 8MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy server:27302 {
        health_uri /healthz
        health_interval 15s
        health_timeout 3s
    }
}
